.env
.env.*
!.env.example

backend/bin/
backend/tmp/
backend/.data/
# Folder berkas unggahan. Ditulis dengan garis miring di depan supaya paket kode backend/internal/storage tidak ikut terabaikan.
/storage/
# Cadangan harian di VM (/srv/nvm-internal/backup), berisi dump database. Tidak boleh masuk git.
/backup/
# rclone.conf di VM (/srv/nvm-internal/secrets), berisi token Google Drive. Foldernya mode 711 milik UID
# 65532, jadi git pun tidak bisa membacanya dan memperingatkan kalau tidak diabaikan di sini.
/secrets/
# Folder staging salinan Drive di VM, isinya symlink sementara ke storage.
/drive-staging/
backend/storage/

node_modules/
frontend/dist/

.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
Thumbs.db
.DS_Store
.claude/settings.local.json
