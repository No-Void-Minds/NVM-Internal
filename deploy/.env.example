# Salin ke deploy/.env di VM lalu isi. deploy/.env tidak boleh masuk git.
# Buat setiap secret dengan openssl rand (lihat docs/runbook-deploy.md), jangan ditulis tangan.

# Jaringan Docker dan container Postgres bersama (compose di ~/nvm-internal/database).
# Cek dengan: docker ps, lalu docker inspect nvm-internal-postgres
PG_NETWORK=nvm-internal_default
PG_CONTAINER=nvm-internal-postgres

# Port di 127.0.0.1 untuk cloudflared. compro 8092, doomsday 8090.
NVM_PORT=8094
# Ganti hanya bila bentrok dengan jaringan Docker lain. compro 172.30.92.0/24, doomsday 172.30.93.0/24.
# Gateway harus alamat di dalam subnet itu.
NVM_SUBNET=172.30.94.0/24
NVM_GATEWAY_IP=172.30.94.1

# Role nvm_internal_app (DML saja), bukan superuser nvm_internal. Host adalah nama container Postgres di jaringan
# Docker, bukan tunnel 15432. Password berkarakter khusus harus di-URL-encode (openssl rand -hex aman).
DATABASE_URL=postgres://nvm_internal_app:GANTI@nvm-internal-postgres:5432/nvm_internal_prod?sslmode=disable

# Hanya untuk migrasi (docs/runbook-deploy.md), tidak dipakai container backend.
MIGRATOR_URL=postgres://nvm_internal_migrator:GANTI@nvm-internal-postgres:5432/nvm_internal_prod?sslmode=disable

# Minimal 32 karakter: openssl rand -hex 32. Mengganti nilai ini membuat semua orang login ulang.
JWT_SECRET=GANTI

# Sesi terkirim juga ke dash. dan studio. yang dijaga Caddy forward_auth. COOKIE_SECURE selalu true di compose.
COOKIE_DOMAIN=novoidminds.xyz

# Ditanam ke frontend saat build; perubahan butuh build ulang frontend.
VITE_DASHBOARD_URL=https://dash.novoidminds.xyz
VITE_ALLOWED_RETURN_HOSTS=novoidminds.xyz,dash.novoidminds.xyz,studio.novoidminds.xyz

# Hanya untuk deploy/backup.sh
BACKUP_DIR=/srv/nvm-internal/backup
