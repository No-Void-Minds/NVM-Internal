APP_ENV=development
HTTP_ADDR=127.0.0.1:8080

# lewat SSH tunnel: ssh -N -L 15432:127.0.0.1:5432 nvmadmin@192.168.68.144
DATABASE_URL=postgres://nvm_internal:GANTI@localhost:15432/nvm_internal?sslmode=disable

JWT_SECRET=GANTI
# true hanya setelah HTTPS terpasang (NFR-SEC-02)
COOKIE_SECURE=false

STORAGE_DIR=./storage

SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=GANTI
# Database khusus test; isinya dikosongkan setiap test jalan. Jangan isi dengan database dev.
TEST_DATABASE_URL=postgres://nvm_internal:GANTI@localhost:15432/nvm_internal_test?sslmode=disable
# Akun uji untuk scripts/dev-login.sh; hanya untuk database dev.
DEV_ADMIN_PASSWORD=GANTI
DEV_STAFF_USERNAME=GANTI
DEV_STAFF_PASSWORD=GANTI