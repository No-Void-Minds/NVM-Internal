APP_ENV=development
HTTP_ADDR=127.0.0.1:8080

# lewat SSH tunnel: ssh -N -L 15432:127.0.0.1:5432 nvmadmin@192.168.68.69
DATABASE_URL=postgres://nvm_internal:GANTI@localhost:15432/nvm_internal?sslmode=disable

JWT_SECRET=GANTI
# true hanya setelah HTTPS terpasang (NFR-SEC-02). Wajib true bila APP_ENV=production; backend menolak start bila tidak.
COOKIE_SECURE=false
# Kosongkan di dev (cookie hanya untuk host ini). Produksi: novoidminds.xyz, supaya sesi juga terkirim ke
# dash.novoidminds.xyz dan studio.novoidminds.xyz yang dijaga Caddy forward_auth ke /api/auth/verify.
# Mengubah nilai ini membuat cookie lama (Domain berbeda) tidak lagi dikenali; pengguna perlu login ulang.
COOKIE_DOMAIN=

STORAGE_DIR=./storage

SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=GANTI
# Database khusus test; isinya dikosongkan setiap test jalan. Jangan isi dengan database dev.
TEST_DATABASE_URL=postgres://nvm_internal:GANTI@localhost:15432/nvm_internal_test?sslmode=disable
# Akun uji untuk scripts/dev-login.sh; hanya untuk database dev.
DEV_ADMIN_PASSWORD=GANTI
DEV_STAFF_USERNAME=GANTI
DEV_STAFF_PASSWORD=GANTI
DEV_MANAGER_USERNAME=GANTI
DEV_MANAGER_PASSWORD=GANTI