# Salin ke frontend/.env.local (dev) atau isi saat build produksi. Nilai VITE_ ikut tertanam di bundle, jangan isi rahasia.

# NVM Launcher (revisi 5). Kosongkan bila belum ada: tombol Dashboard tidak tampil.
# Produksi: https://dash.novoidminds.xyz
VITE_DASHBOARD_URL=

# Host yang boleh menjadi tujuan ?kembali= setelah login, dipisah koma, tanpa https:// dan tanpa port.
# Produksi: novoidminds.xyz,dash.novoidminds.xyz,studio.novoidminds.xyz
VITE_ALLOWED_RETURN_HOSTS=
